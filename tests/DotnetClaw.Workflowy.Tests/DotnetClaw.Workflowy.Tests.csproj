<Project Sdk="Microsoft.NET.Sdk">

  <!-- ═══════════════════════════════════════════════════════════════════════
       DotnetClaw.Workflowy.Tests — xUnit Test Project
       ═══════════════════════════════════════════════════════════════════════ -->

  <PropertyGroup Label="Test Project Identity">
    <RootNamespace>DotnetClaw.Workflowy.Tests</RootNamespace>
    <AssemblyName>DotnetClaw.Workflowy.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Disable .NET 10 package pruning — test projects have complex dependency graphs -->
    <NuGetPrunePackageReferences>false</NuGetPrunePackageReferences>
  </PropertyGroup>

  <PropertyGroup Label="Test Behaviour">
    <ParallelizeAssembly>true</ParallelizeAssembly>
    <ParallelizeTestCollections>true</ParallelizeTestCollections>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup Label="xUnit Test Framework">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Label="EF Core In-Memory (for integration tests)">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup Label="Microsoft Extensions (test utilities)">
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Label="Projects Under Test">
    <ProjectReference Include="..\..\src\DotnetClaw.Workflowy\DotnetClaw.Workflowy.csproj" />
  </ItemGroup>

</Project>
