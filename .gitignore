## DotnetClaw .gitignore
## Based on github/gitignore Visual Studio template

# Build outputs
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Publish output (profiles write here)
**/bin/publish/

# Coverage reports
**/coverage/

# VS / Rider user files
.vs/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# NuGet
.nuget/
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json
artifacts/

# Rider
_ReSharper*/
*.DotSettings.user

# MSBuild
*.msbuild.binlog

# dotnet tool manifests (keep .config/dotnet-tools.json)
!.config/

# Secrets — NEVER commit real tokens
appsettings.Development.json
appsettings.Local.json
**/secrets.json
*.env
.env

# OS artefacts
.DS_Store
Thumbs.db
desktop.ini
