<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ═══════════════════════════════════════════════════════════════════════
       DotnetClawHub — Skills Directory (Web API + Blazor + SQLite)
       A minimal ClawHub-inspired skills registry for DotnetClaw agents.
       ═══════════════════════════════════════════════════════════════════════ -->

  <PropertyGroup Label="Application">
    <RootNamespace>DotnetClawHub</RootNamespace>
    <AssemblyName>DotnetClawHub</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup Label="EF Core + SQLite">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup Label="Config">
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
