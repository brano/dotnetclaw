@page "/skills/{name}"
@inject AppDbContext Db
@inject NavigationManager Nav

<PageTitle>@(_skill?.DisplayName ?? Name) — DotnetClawHub</PageTitle>

@if (_skill is null)
{
    <div class="flex flex-col items-center justify-center min-h-[50vh] text-center px-6">
        <div class="text-5xl mb-4">🔍</div>
        <h1 class="text-lg font-semibold text-[hsl(213_31%_91%)] mb-2">Skill not found</h1>
        <p class="text-sm text-[hsl(215.4_16.3%_50%)] mb-6">No skill named <code class="text-xs bg-[hsl(216_34%_12%)] px-1.5 py-0.5 rounded">@Name</code> exists.</p>
        <a href="/browse" class="text-sm text-[hsl(338deg_80%_62%)] hover:underline">← Browse all skills</a>
    </div>
}
else
{
    <!-- Main detail layout -->
    <div class="max-w-7xl mx-auto px-6 py-8">

        <!-- Breadcrumb -->
        <nav class="flex items-center gap-1.5 text-xs text-[hsl(215.4_16.3%_35%)] mb-6">
            <a href="/browse" class="hover:text-[hsl(213_31%_91%)] transition-colors">Skills</a>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="m9 18 6-6-6-6"/>
            </svg>
            <span class="text-[hsl(215.4_16.3%_55%)]">@_skill.Name</span>
        </nav>

        <!-- Two-column layout -->
        <div class="flex gap-8 items-start">

            <!-- Left: main content -->
            <div class="flex-1 min-w-0">

                <!-- Title + description -->
                <h1 class="text-3xl font-bold text-[hsl(213_31%_96%)] mb-2">@_skill.DisplayName</h1>
                @if (!string.IsNullOrWhiteSpace(_skill.Description))
                {
                    <p class="text-[hsl(215.4_16.3%_60%)] text-base mb-4 leading-relaxed">@_skill.Description</p>
                }

                <!-- Tags as badges -->
                @if (_skill.TagList.Length > 0)
                {
                    <div class="flex flex-wrap gap-1.5 mb-4">
                        @foreach (var tag in _skill.TagList)
                        {
                            <span class="tag-badge">@tag</span>
                        }
                    </div>
                }

                <!-- Stats row -->
                <div class="flex items-center gap-4 text-sm text-[hsl(215.4_16.3%_50%)] mb-6 flex-wrap">
                    <span class="flex items-center gap-1.5">
                        <svg class="w-4 h-4 text-[hsl(215.4_16.3%_40%)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        @_skill.Downloads downloads
                    </span>
                    <span>·</span>
                    <span>by <span class="text-[hsl(215.4_16.3%_65%)]">@@@_skill.Author</span></span>
                    <span>·</span>
                    <span>@_skill.CreatedAt.ToString("dd.MM.yyyy")</span>
                    @if (_skill.UpdatedAt.Date != _skill.CreatedAt.Date)
                    {
                        <span>· updated @_skill.UpdatedAt.ToString("dd.MM.yyyy")</span>
                    }
                </div>

                <!-- Version badge -->
                <div class="flex items-center gap-2 mb-6">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-semibold
                                 bg-[hsl(220_100%_54%/0.15)] text-[hsl(220_100%_74%)] border border-[hsl(220_100%_54%/0.3)]">
                        latest
                    </span>
                    <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-semibold
                                 bg-[hsl(216_34%_12%)] text-[hsl(215.4_16.3%_65%)] border border-[hsl(216_34%_18%)]">
                        v@_skill.Version
                    </span>
                </div>

                <!-- Info cards -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
                    <!-- Install card -->
                    <div class="p-4 rounded-xl border border-[hsl(216_34%_14%)] bg-[hsl(222.2_47.4%_4%)]">
                        <h3 class="text-xs font-semibold uppercase tracking-widest text-[hsl(215.4_16.3%_35%)] mb-3">Install</h3>
                        <p class="text-xs text-[hsl(215.4_16.3%_50%)] mb-2">Place in your workspace skills folder:</p>
                        <code class="block text-xs font-mono text-[hsl(220_100%_68%)] bg-[hsl(216_34%_9%)]
                                     border border-[hsl(216_34%_14%)] rounded px-3 py-2 overflow-x-auto whitespace-nowrap">
                            curl -s @_baseUrl/api/skills/@_skill.Name/SKILL.md -o SKILL.md
                        </code>
                    </div>

                    <!-- Runtime card -->
                    <div class="p-4 rounded-xl border border-[hsl(216_34%_14%)] bg-[hsl(222.2_47.4%_4%)]">
                        <h3 class="text-xs font-semibold uppercase tracking-widest text-[hsl(215.4_16.3%_35%)] mb-3">Runtime</h3>
                        <div class="flex items-center gap-2 p-2.5 rounded-lg bg-[hsl(216_34%_9%)] border border-[hsl(216_34%_14%)]">
                            <span class="text-base">🦀</span>
                            <span class="text-sm font-medium text-[hsl(213_31%_85%)]">DotnetClaw</span>
                        </div>
                        <p class="text-[10px] text-[hsl(215.4_16.3%_35%)] mt-2">
                            Place SKILL.md in <code class="font-mono">workspace/skills/@_skill.Name/</code>
                        </p>
                    </div>
                </div>

                <!-- SKILL.md file viewer -->
                <div class="rounded-xl border border-[hsl(216_34%_14%)] overflow-hidden">
                    <!-- Tab bar -->
                    <div class="flex items-center gap-0 border-b border-[hsl(216_34%_13%)] bg-[hsl(222.2_47.4%_3%)]">
                        <button class="px-4 py-2.5 text-xs font-semibold text-[hsl(213_31%_91%)]
                                       border-b-2 border-[hsl(338deg_80%_52%)] bg-[hsl(222.2_47.4%_5%)]">
                            Files
                        </button>
                        <div class="flex-1"></div>
                        <a href="/api/skills/@_skill.Name/SKILL.md" target="_blank"
                           class="flex items-center gap-1.5 mr-3 px-3 py-1.5 rounded-md text-xs font-medium
                                  text-[hsl(215.4_16.3%_50%)] hover:text-[hsl(213_31%_91%)] hover:bg-[hsl(216_34%_14%)] transition-colors">
                            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                            </svg>
                            Raw
                        </a>
                    </div>

                    <!-- File list + content side by side -->
                    <div class="flex divide-x divide-[hsl(216_34%_12%)]">
                        <!-- File list (left) -->
                        <div class="w-48 shrink-0 bg-[hsl(222.2_47.4%_3%)]">
                            <div class="px-3 py-2 border-b border-[hsl(216_34%_12%)]">
                                <span class="text-[10px] font-semibold uppercase tracking-widest text-[hsl(215.4_16.3%_30%)]">
                                    1 total
                                </span>
                            </div>
                            <div class="p-2">
                                <div class="flex items-center justify-between px-2 py-1.5 rounded bg-[hsl(216_34%_12%)]">
                                    <div class="flex items-center gap-1.5">
                                        <svg class="w-3.5 h-3.5 text-[hsl(215.4_16.3%_45%)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                            <polyline points="14 2 14 8 20 8"/>
                                        </svg>
                                        <span class="text-xs font-mono text-[hsl(213_31%_85%)]">SKILL.md</span>
                                    </div>
                                    <span class="text-[10px] text-[hsl(215.4_16.3%_35%)]">
                                        @GetKb(_skill.SkillMarkdown) KB
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Content (right) -->
                        <div class="flex-1 min-w-0 bg-[hsl(222.2_47.4%_3%)]">
                            <div class="flex items-center justify-between px-4 py-2 border-b border-[hsl(216_34%_12%)]">
                                <span class="text-xs font-mono text-[hsl(215.4_16.3%_45%)]">SKILL.md</span>
                                <span class="text-[10px] text-[hsl(215.4_16.3%_30%)] font-mono">
                                    @GetKb(_skill.SkillMarkdown) KB
                                </span>
                            </div>
                            <div class="skill-md overflow-auto max-h-[600px]">
                                <pre class="text-xs text-[hsl(213_31%_82%)] p-4 min-w-max">@_skill.SkillMarkdown</pre>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Right sidebar -->
            <div class="w-56 shrink-0 space-y-3">
                <div class="rounded-xl border border-[hsl(216_34%_14%)] bg-[hsl(222.2_47.4%_4%)] p-4">
                    <p class="text-[9px] font-semibold uppercase tracking-widest text-[hsl(215.4_16.3%_35%)] mb-1">Current Version</p>
                    <p class="text-xl font-bold text-[hsl(213_31%_91%)] mb-3">v@_skill.Version</p>

                    <a href="/api/skills/@_skill.Name/SKILL.md" target="_blank"
                       class="flex items-center justify-center gap-2 w-full px-4 py-2 rounded-lg
                              bg-[hsl(338deg_80%_52%)] hover:bg-[hsl(338deg_80%_58%)]
                              text-white text-xs font-semibold transition-colors">
                        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                        </svg>
                        Download SKILL.md
                    </a>
                </div>

                <div class="rounded-xl border border-[hsl(216_34%_14%)] bg-[hsl(222.2_47.4%_4%)] p-4 space-y-2">
                    <div>
                        <p class="text-[9px] font-semibold uppercase tracking-widest text-[hsl(215.4_16.3%_30%)] mb-1">Downloads</p>
                        <p class="text-sm font-semibold text-[hsl(213_31%_85%)]">@_skill.Downloads</p>
                    </div>
                    <div>
                        <p class="text-[9px] font-semibold uppercase tracking-widest text-[hsl(215.4_16.3%_30%)] mb-1">Author</p>
                        <p class="text-sm text-[hsl(213_31%_85%)] font-mono">@@_skill.Author</p>
                    </div>
                    <div>
                        <p class="text-[9px] font-semibold uppercase tracking-widest text-[hsl(215.4_16.3%_30%)] mb-1">Published</p>
                        <p class="text-xs text-[hsl(215.4_16.3%_50%)]">@_skill.CreatedAt.ToString("MMM d, yyyy")</p>
                    </div>
                </div>

                <a href="/publish?name=@_skill.Name"
                   class="flex items-center justify-center gap-1.5 w-full px-4 py-2 rounded-lg
                          text-xs font-medium text-[hsl(215.4_16.3%_50%)] hover:text-[hsl(213_31%_91%)]
                          border border-[hsl(216_34%_15%)] hover:bg-[hsl(216_34%_14%)] transition-colors">
                    Update this skill
                </a>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Name { get; set; } = "";

    private Skill? _skill;
    private string _baseUrl = "";

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not null)
        {
            var req = HttpContext.Request;
            _baseUrl = $"{req.Scheme}://{req.Host}";
        }

        _skill = await Db.Skills.FirstOrDefaultAsync(s => s.Name == Name);
    }

    private static string GetKb(string text)
    {
        var bytes = System.Text.Encoding.UTF8.GetByteCount(text);
        return (bytes / 1024.0).ToString("0.0");
    }
}
