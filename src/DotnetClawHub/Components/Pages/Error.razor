@page "/Error"
@using Microsoft.AspNetCore.Diagnostics

<PageTitle>Error — DotnetClawHub</PageTitle>

<div class="flex flex-col items-center justify-center h-full py-32 text-center px-8">
    <span class="text-5xl mb-4">⚠️</span>
    <h1 class="text-xl font-semibold text-[hsl(213_31%_91%)] mb-2">Something went wrong</h1>
    <p class="text-sm text-[hsl(215.4_16.3%_50%)] mb-6">An unexpected error occurred. Please try again.</p>
    <a href="/" class="px-4 py-2 rounded-md bg-[hsl(216_34%_17%)] hover:bg-[hsl(216_34%_22%)]
                       text-sm font-medium text-[hsl(213_31%_91%)] border border-[hsl(216_34%_22%)] transition-colors">
        Go home
    </a>
</div>
