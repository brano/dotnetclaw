@page "/"
@inject AppDbContext Db

<PageTitle>DotnetClawHub — Skills Directory</PageTitle>

<!-- Hero -->
<section class="border-b border-[hsl(216_34%_12%)] bg-[hsl(222.2_47.4%_3%)]">
    <div class="max-w-7xl mx-auto px-6 py-16 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">

        <!-- Left: headline + CTAs -->
        <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[hsl(338deg_95%_58%/40%)]
                        bg-[hsl(338deg_80%_52%/12%)] text-xs font-medium text-[hsl(338deg_80%_72%)] mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-[hsl(338deg_80%_62%)]"></span>
                Skills for DotnetClaw agents
            </div>

            <h1 class="text-4xl lg:text-5xl font-bold text-[hsl(213_31%_96%)] leading-tight mb-4">
                DotnetClawHub<br />
                <span class="text-[hsl(338.27_80.33%_52.16%)]">Agent Skills Hub</span><br />
                for .NET agents
            </h1>

            <p class="text-[hsl(215.4_16.3%_56.9%)] text-base mb-8 max-w-sm leading-relaxed">
                Publish SKILL.md files, version them, and make them downloadable for DotnetClaw agents. No gatekeeping, just signal.
            </p>

            <div class="flex items-center gap-3">
                <a href="/publish"
                   class="px-5 py-2.5 rounded-md bg-[hsl(338deg_80%_52%)] hover:bg-[hsl(338deg_80%_58%)]
                          text-white text-sm font-semibold transition-colors shadow-sm">
                    Publish Skill
                </a>
                <a href="/browse"
                   class="px-5 py-2.5 rounded-md bg-[hsl(216_34%_14%)] hover:bg-[hsl(216_34%_18%)]
                          text-[hsl(213_31%_91%)] text-sm font-semibold border border-[hsl(216_34%_20%)] transition-colors">
                    Browse skills
                </a>
            </div>
        </div>

        <!-- Right: install command box -->
        <div class="rounded-xl border border-[hsl(216_34%_17%)] bg-[hsl(222.2_47.4%_4%)] p-6">
            <p class="text-xs text-[hsl(215.4_16.3%_45%)] mb-1">Search skills. Always up-to-date.</p>
            <p class="text-sm text-[hsl(213_31%_80%)] mb-4">Install any skill in one shot:</p>

            <div class="rounded-lg bg-[hsl(216_34%_9%)] border border-[hsl(216_34%_15%)] px-4 py-3 font-mono text-sm
                        text-[hsl(253.66_66.01%_70%)] overflow-x-auto">
				curl -s @_baseUrl/api/skills/<span class="text-[hsl(338.27_80.33%_52.16%)]">summarize</span>/SKILL.md -o SKILL.md
            </div>

            <div class="mt-4 pt-4 border-t border-[hsl(216_34%_14%)] flex items-center gap-6">
                <div class="text-center">
                    <div class="text-2xl font-bold text-[hsl(213_31%_91%)]">@_totalSkills</div>
                    <div class="text-xs text-[hsl(215.4_16.3%_40%)]">skills</div>
                </div>
                <div class="text-center">
                    <div class="text-2xl font-bold text-[hsl(213_31%_91%)]">@_totalDownloads</div>
                    <div class="text-xs text-[hsl(215.4_16.3%_40%)]">downloads</div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Highlighted / Recent skills -->
<section class="max-w-7xl mx-auto px-6 py-12">
    @if (_skills.Count == 0)
    {
        <div class="flex flex-col items-center justify-center py-24 text-center">
            <div class="w-16 h-16 rounded-2xl bg-[hsl(338deg_80%_52%/12%)] border border-[hsl(338deg_95%_58%/30%)]
                        flex items-center justify-center mb-4 text-3xl">
                📦
            </div>
            <h2 class="text-lg font-semibold text-[hsl(213_31%_91%)] mb-2">No skills published yet</h2>
            <p class="text-sm text-[hsl(215.4_16.3%_50%)] mb-6 max-w-xs">
                Be the first to share a skill with the DotnetClaw community.
            </p>
            <a href="/publish"
               class="px-5 py-2.5 rounded-md bg-[hsl(338deg_80%_52%)] hover:bg-[hsl(338deg_80%_58%)]
                      text-white text-sm font-semibold transition-colors">
                Publish your first skill
            </a>
        </div>
    }
    else
    {
        <div class="flex items-center justify-between mb-6">
            <div>
                <h2 class="text-lg font-semibold text-[hsl(213_31%_91%)]">Highlighted skills</h2>
                <p class="text-sm text-[hsl(215.4_16.3%_45%)] mt-0.5">Popular picks — highlighted for quick trust.</p>
            </div>
            <a href="/browse" class="text-xs text-[hsl(220_100%_63%)] hover:text-[hsl(220_100%_74%)] transition-colors flex items-center gap-1">
                See all @_totalSkills
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="m9 18 6-6-6-6"/>
                </svg>
            </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            @foreach (var skill in _skills)
            {
                <a href="/skills/@skill.Name"
                   class="flex flex-col p-4 rounded-xl border border-[hsl(216_34%_14%)] bg-[hsl(222.2_47.4%_4%)]
                          hover:border-[hsl(220_100%_54%/0.35)] hover:bg-[hsl(222.2_47.4%_5%)]
                          transition-all group">

                    <div class="flex items-start gap-2 mb-2">
                        <!-- highlighted badge (shown on all for now) -->
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold
                                     bg-[hsl(338deg_80%_52%/18%)] text-[hsl(338deg_80%_68%)] border border-[hsl(338deg_95%_58%/30%)]">
                            Highlighted
                        </span>
                    </div>

                    <h3 class="text-sm font-semibold text-[hsl(213_31%_91%)] group-hover:text-[hsl(220_100%_74%)] transition-colors mb-1">
                        @skill.DisplayName
                    </h3>

                    <p class="text-xs text-[hsl(215.4_16.3%_50%)] line-clamp-3 flex-1 leading-relaxed mb-3">
                        @skill.Description
                    </p>

                    <div class="flex items-center justify-between mt-auto pt-2 border-t border-[hsl(216_34%_12%)]">
                        <span class="text-xs text-[hsl(215.4_16.3%_40%)]">by @skill.Author</span>
                        <div class="flex items-center gap-1 text-xs text-[hsl(215.4_16.3%_40%)]">
                            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                                <polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
                            </svg>
                            @skill.Downloads
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</section>

@code {
    private List<Skill> _skills = [];
    private int _totalSkills;
    private int _totalDownloads;
    private string _baseUrl = "";

    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is not null)
        {
            var req = HttpContext.Request;
            _baseUrl = $"{req.Scheme}://{req.Host}";
        }

        _skills = await Db.Skills
            .OrderByDescending(s => s.Downloads)
            .Take(8)
            .ToListAsync();

        _totalSkills = await Db.Skills.CountAsync();
        _totalDownloads = await Db.Skills.SumAsync(s => (int?)s.Downloads) ?? 0;
    }
}
