<Project Sdk="Microsoft.NET.Sdk">

  <!-- ═══════════════════════════════════════════════════════════════════════
       DotnetClaw — Main Application
       OpenClaw-inspired AI assistant built on .NET 10 + Semantic Kernel
       ═══════════════════════════════════════════════════════════════════════ -->

  <PropertyGroup Label="Application">
    <OutputType>Exe</OutputType>
    <RootNamespace>DotnetClaw</RootNamespace>
    <AssemblyName>DotnetClaw</AssemblyName>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- ── NuGet Dependencies ────────────────────────────────────────────────
       Versions resolved from /Directory.Packages.props (Central Package Management).
  -->

  <ItemGroup Label="Semantic Kernel">
    <PackageReference Include="Microsoft.SemanticKernel" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.Core" />
    <PackageReference Include="Microsoft.SemanticKernel.Agents.OpenAI" />
  </ItemGroup>

  <ItemGroup Label="MCP (Model Context Protocol)">
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup Label="Microsoft Extensions">
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup Label="UI">
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup Label="Workflowy Workflow Engine">
    <ProjectReference Include="..\DotnetClaw.Workflowy\DotnetClaw.Workflowy.csproj" />
  </ItemGroup>

  <ItemGroup Label="Browser Automation">
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <ItemGroup Label="Serialisation">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\DotnetClaw.Jobby\DotnetClaw.Jobby.csproj" />
  </ItemGroup>

  <!-- ── Content Files ──────────────────────────────────────────────────── -->

  <ItemGroup Label="Config">
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Workspace identity documents — copied to output so dotnet run finds them -->
  <ItemGroup Label="Workspace">
    <None Update="..\..\workspace\**\*" Condition="Exists('..\..\workspace\')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>workspace\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <PropertyGroup Label="Publish">
    <!--
      Supported self-contained publish RIDs.
      Use: dotnet publish -c Release -r win-x64 - -self-contained
    -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <Authors>Brano Lukac &amp; Claude Sonnet</Authors>
    <Company>Brano Lukac</Company>
    <PackageProjectUrl>https://github.com/brano/DotnetClaw</PackageProjectUrl>
  </PropertyGroup>

</Project>
