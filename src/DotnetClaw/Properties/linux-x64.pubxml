<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: Linux x64 — self-contained single-file binary

  Usage:
    dotnet publish src/DotnetClaw/DotnetClaw.csproj -c Release /p:PublishProfile=linux-x64

  Output: src/DotnetClaw/bin/publish/linux-x64/DotnetClaw
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildProjectDirectory)/bin/publish/linux-x64/</PublishDir>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
