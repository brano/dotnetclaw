<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: Windows x64 — self-contained single-file executable

  Usage:
    dotnet publish src/DotnetClaw/DotnetClaw.csproj -c Release /p:PublishProfile=win-x64

  Output: src/DotnetClaw/bin/publish/win-x64/DotnetClaw.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>$(MSBuildProjectDirectory)\bin\publish\win-x64\</PublishDir>

    <!-- Single-file self-contained executable -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>

    <!-- Trim unused framework code to reduce size -->
    <PublishTrimmed>false</PublishTrimmed>   <!-- keep false — reflection-heavy SK may break -->

    <!-- Remove PDB from the output folder (PDB is embedded in Release via Directory.Build.props) -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
