<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile: macOS arm64 (Apple Silicon) — self-contained single-file binary

  Usage:
    dotnet publish src/DotnetClaw/DotnetClaw.csproj -c Release /p:PublishProfile=osx-arm64

  Output: src/DotnetClaw/bin/publish/osx-arm64/DotnetClaw
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>osx-arm64</RuntimeIdentifier>
    <PublishDir>$(MSBuildProjectDirectory)/bin/publish/osx-arm64/</PublishDir>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>false</PublishReadyToRun>   <!-- R2R not supported cross-platform -->
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
