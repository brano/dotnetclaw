<Project Sdk="Microsoft.NET.Sdk">

  <!-- ═══════════════════════════════════════════════════════════════════════
       DotnetClaw.Workflowy — Deterministic Workflow Shell
       Inspired by OpenClaw's Lobster CLI. Runs YAML/JSON workflow files with
       typed pipelines, approval gates, and SQLite-backed resumable state.
       ═══════════════════════════════════════════════════════════════════════ -->

  <PropertyGroup Label="Application">
    <OutputType>Exe</OutputType>
    <RootNamespace>DotnetClaw.Workflowy</RootNamespace>
    <AssemblyName>DotnetClaw.Workflowy</AssemblyName>
  </PropertyGroup>

  <ItemGroup Label="Semantic Kernel">
    <PackageReference Include="Microsoft.SemanticKernel" />
  </ItemGroup>

  <ItemGroup Label="EF Core + SQLite">
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
  </ItemGroup>

  <ItemGroup Label="Workflow Parsing">
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup Label="Microsoft Extensions">
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup Label="Config">
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup Label="Publish">
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
