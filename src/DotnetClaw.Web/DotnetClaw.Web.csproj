<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ═══════════════════════════════════════════════════════════════════════
       DotnetClaw.Web — Blazor Server Web UI
       OpenClaw-inspired dashboard built on .NET 10 + Blazor + Tailwind CSS
       ═══════════════════════════════════════════════════════════════════════ -->

  <PropertyGroup Label="Application">
    <RootNamespace>DotnetClaw.Web</RootNamespace>
    <AssemblyName>DotnetClaw.Web</AssemblyName>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\DotnetClaw\DotnetClaw.csproj" />
  </ItemGroup>

  <ItemGroup Label="Config">
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.Development.json" Condition="Exists('appsettings.Development.json')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
