@* Dashboard stat card *@

<div class="rounded-lg border border-[hsl(216_34%_17%)] bg-[hsl(222.2_47.4%_6%)] p-4 space-y-2">
    <div class="flex items-center justify-between">
        <p class="text-xs font-medium text-[hsl(215.4_16.3%_50%)] uppercase tracking-wide">@Label</p>
        <div class="@(IsActive ? "w-7 h-7 rounded-md bg-[hsl(220_100%_54%/0.15)] text-[hsl(220_100%_63%)] flex items-center justify-center" : "w-7 h-7 rounded-md bg-[hsl(216_34%_14%)] text-[hsl(215.4_16.3%_40%)] flex items-center justify-center")">
            <div class="w-4 h-4">@((MarkupString)Icon)</div>
        </div>
    </div>
    <div class="flex items-end gap-1">
        <p class="text-xl font-bold text-[hsl(213_31%_91%)]">@Value</p>
        @if (IsActive)
        {
            <span class="mb-0.5 flex h-2 w-2 rounded-full bg-[hsl(220_100%_54%)] animate-pulse"></span>
        }
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = string.Empty;
    [Parameter] public bool IsActive { get; set; }
}
