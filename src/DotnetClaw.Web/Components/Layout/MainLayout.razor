@inherits LayoutComponentBase
@inject AppState AppState
@implements IDisposable

<div class="flex h-screen overflow-hidden bg-[hsl(224_71%_4%)]">
    <!-- Sidebar -->
    <aside class="flex flex-col w-60 shrink-0 border-r border-[hsl(216_34%_17%)] bg-[hsl(222.2_47.4%_4%)]">
        <!-- Logo -->
        <div class="flex items-center gap-3 px-4 py-5 border-b border-[hsl(216_34%_17%)]">
			<div class="flex items-center justify-center w-8 h-8 rounded-lg bg-[hsl(335deg_97%_64%/29%)] border border-[hsl(338deg_95%_58%/58%)]">
                <span style="font-size: 22px;">🦀</span>
            </div>
            <div>
				<span class="text-sm font-semibold text-[hsl(270.25_90.84%_74.31%)]">DotnetClaw</span>
				<p class="text-[10px] text-[hsl(215.4_16.3%_40%)] leading-tight">Your AI Assistant in .NET</p>
            </div>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 px-2 py-4 space-y-1 overflow-y-auto">
            <NavLink href="/" Match="NavLinkMatch.All" class="nav-item" ActiveClass="nav-link-active">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                    <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
                </svg>
                Dashboard
            </NavLink>

            <NavLink href="/chat" class="nav-item" ActiveClass="nav-link-active">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                Chat
                @if (AppState.AgentRunning)
                {
                    <span class="ml-auto flex h-2 w-2 rounded-full bg-[hsl(220_100%_54%)] animate-pulse"></span>
                }
            </NavLink>

            <NavLink href="/skills" class="nav-item" ActiveClass="nav-link-active">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
                </svg>
                Skills
            </NavLink>

            <NavLink href="/terminal" class="nav-item" ActiveClass="nav-link-active">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="4 17 10 11 4 5"/>
                    <line x1="12" y1="19" x2="20" y2="19"/>
                </svg>
                Terminal
                @if (AppState.AgentRunning)
                {
                    <span class="ml-auto flex h-2 w-2 rounded-full bg-[hsl(220_100%_54%)] animate-pulse"></span>
                }
            </NavLink>

            <NavLink href="/telegram" class="nav-item" ActiveClass="nav-link-active">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
                </svg>
                Telegram
                @if (AppState.TelegramConnected)
                {
                    <span class="ml-auto flex h-2 w-2 rounded-full bg-emerald-400"></span>
                }
            </NavLink>

            <div class="pt-3 pb-1 px-2">
                <p class="text-[10px] font-semibold uppercase tracking-widest text-[hsl(215.4_16.3%_35%)]">Settings</p>
            </div>

            <NavLink href="/onboarding" class="nav-item" ActiveClass="nav-link-active">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/>
                </svg>
                Onboarding
            </NavLink>
        </nav>

        <!-- Status footer -->
        <div class="px-4 py-3 border-t border-[hsl(216_34%_17%)]">
            <div class="flex items-center gap-2">
                <div class="@(AppState.AgentRunning ? "w-2 h-2 rounded-full bg-[hsl(220_100%_54%)] animate-pulse" : "w-2 h-2 rounded-full bg-[hsl(215.4_16.3%_35%)]")"></div>
                <span class="text-xs text-[hsl(215.4_16.3%_50%)]">@AppState.AgentStatus</span>
            </div>
        </div>
    </aside>

    <!-- Main content -->
    <main class="flex-1 overflow-y-auto">
        @Body
    </main>
</div>

<style>
    .nav-item {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        padding: 0.5rem 0.75rem;
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        font-weight: 500;
        color: hsl(215.4 16.3% 56.9%);
        transition: background-color 0.15s, color 0.15s;
        border-left: 2px solid transparent;
        text-decoration: none;
    }
    .nav-item:hover {
        background-color: hsl(216 34% 17%);
        color: hsl(213 31% 91%);
    }
</style>

@code {
    protected override void OnInitialized()
    {
        AppState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
