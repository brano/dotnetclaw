@page "/onboarding"
@rendermode InteractiveServer
@inject AppState AppState
@inject NavigationManager Nav
@inject IOptions<DotnetClawOptions> Options

<PageTitle>Onboarding — DotnetClaw</PageTitle>

<div class="min-h-screen flex items-center justify-center p-6 bg-[hsl(224_71%_4%)]">
    <div class="w-full max-w-2xl animate-fade-in">

        <!-- Progress steps -->
        <div class="flex items-center justify-center gap-2 mb-10">
            @foreach (var (step, label) in Steps)
            {
                var isActive = AppState.CurrentOnboardingStep == step;
                var isDone = (int)AppState.CurrentOnboardingStep > (int)step;
                <div class="flex items-center gap-2">
                    <div class="flex items-center gap-1.5">
                        <div class="@(isDone ? "w-6 h-6 rounded-full bg-[hsl(220_100%_54%)] flex items-center justify-center" : isActive ? "w-6 h-6 rounded-full border-2 border-[hsl(220_100%_54%)] flex items-center justify-center" : "w-6 h-6 rounded-full border-2 border-[hsl(216_34%_17%)] flex items-center justify-center")">
                            @if (isDone)
                            {
                                <svg class="w-3 h-3 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                            }
                            else
                            {
                                <span class="@(isActive ? "text-[hsl(220_100%_63%)] text-xs font-bold" : "text-[hsl(215.4_16.3%_40%)] text-xs")">@((int)step + 1)</span>
                            }
                        </div>
                        <span class="text-xs @(isActive ? "text-[hsl(213_31%_91%)] font-medium" : isDone ? "text-[hsl(215.4_16.3%_56.9%)]" : "text-[hsl(215.4_16.3%_35%)]")">@label</span>
                    </div>
                    @if (step != OnboardingStep.Done)
                    {
                        <div class="w-8 h-px bg-[hsl(216_34%_17%)]"></div>
                    }
                </div>
            }
        </div>

        <!-- Step content -->
        @if (AppState.CurrentOnboardingStep == OnboardingStep.Welcome)
        {
            <Card>
                <HeaderContent>
                    <div class="text-center space-y-3 pt-2">
                        <div class="flex items-center justify-center w-16 h-16 mx-auto rounded-2xl bg-[hsl(220_100%_54%/0.15)] border border-[hsl(220_100%_54%/0.3)]">
                            <svg class="w-8 h-8 text-[hsl(220_100%_63%)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                <path d="M2 17l10 5 10-5"/>
                                <path d="M2 12l10 5 10-5"/>
                            </svg>
                        </div>
                        <h1 class="text-2xl font-bold text-[hsl(213_31%_91%)]">Welcome to DotnetClaw</h1>
                        <p class="text-sm text-[hsl(215.4_16.3%_56.9%)] max-w-md mx-auto">
                            Your OpenClaw-inspired AI assistant built on .NET 10 and Microsoft Semantic Kernel.
                            Let's get you set up in a few quick steps.
                        </p>
                    </div>
                </HeaderContent>
                <ChildContent>
                    <div class="space-y-4">
                        <div class="grid grid-cols-2 gap-3">
                            <FeatureCard Icon="⚡" Title="Agentic Loop" Description="Multi-step tool-use with Semantic Kernel" />
                            <FeatureCard Icon="🔌" Title="Skills" Description="Shell, FileSystem, Browser, Cursor, MCP" />
                            <FeatureCard Icon="📱" Title="Telegram Bot" Description="Control your agent from anywhere" />
                            <FeatureCard Icon="🌐" Title="Web UI" Description="Beautiful dashboard to monitor & chat" />
                        </div>
                        <div class="flex justify-end pt-2">
                            <Button Variant="default" OnClick="NextStep">
                                Get Started
                                <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M5 12h14M12 5l7 7-7 7"/>
                                </svg>
                            </Button>
                        </div>
                    </div>
                </ChildContent>
            </Card>
        }

        @if (AppState.CurrentOnboardingStep == OnboardingStep.ModelSetup)
        {
            <Card Title="Configure AI Model" Description="Set your LLM provider and model">
                <ChildContent>
                    <div class="space-y-5">
                        <div class="space-y-2">
                            <label class="text-sm font-medium text-[hsl(213_31%_91%)]">Provider</label>
                            <div class="grid grid-cols-3 gap-2">
                                @foreach (var p in new[] { "openai", "azure", "anthropic" })
                                {
                                    <button
                                        type="button"
                                        class="@(selectedProvider == p ? "rounded-md border-2 border-[hsl(220_100%_54%)] bg-[hsl(220_100%_54%/0.1)] px-3 py-2 text-sm font-medium text-[hsl(220_100%_74%)]" : "rounded-md border border-[hsl(216_34%_17%)] bg-[hsl(222.2_47.4%_8%)] px-3 py-2 text-sm text-[hsl(215.4_16.3%_56.9%)] hover:border-[hsl(216_34%_30%)] hover:text-[hsl(213_31%_91%)]")"
                                        @onclick="() => selectedProvider = p">
                                        @p.ToUpperInvariant()
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-[hsl(213_31%_91%)]">Model ID</label>
                            <Input Value="@modelId" OnInput="e => modelId = e.Value?.ToString() ?? string.Empty"
                                   Placeholder="e.g. gpt-4o-mini, claude-3-5-sonnet-20241022" />
                            <p class="text-xs text-[hsl(215.4_16.3%_40%)]">Current: @Options.Value.ModelId</p>
                        </div>

                        <div class="space-y-2">
                            <label class="text-sm font-medium text-[hsl(213_31%_91%)]">API Key</label>
                            <Input Type="password" Value="@apiKey" OnInput="e => apiKey = e.Value?.ToString() ?? string.Empty"
                                   Placeholder="sk-..." />
                            <p class="text-xs text-[hsl(215.4_16.3%_40%)]">Stored in environment variables, never persisted to disk.</p>
                        </div>

                        <div class="p-3 rounded-md bg-amber-900/20 border border-amber-800/40">
                            <p class="text-xs text-amber-300">
                                💡 You can also set <code class="font-mono bg-amber-900/30 px-1 rounded">OPENAI_API_KEY</code> as an environment variable before starting DotnetClaw.
                            </p>
                        </div>

                        <div class="flex justify-between pt-2">
                            <Button Variant="ghost" OnClick="PrevStep">Back</Button>
                            <Button Variant="default" OnClick="NextStep">Continue</Button>
                        </div>
                    </div>
                </ChildContent>
            </Card>
        }

        @if (AppState.CurrentOnboardingStep == OnboardingStep.TelegramSetup)
        {
            <Card Title="Telegram Bot (Optional)" Description="Connect your Telegram bot to control DotnetClaw remotely">
                <ChildContent>
                    <div class="space-y-5">
                        <div class="flex items-center justify-between p-3 rounded-md bg-[hsl(222.2_47.4%_8%)] border border-[hsl(216_34%_17%)]">
                            <div>
                                <p class="text-sm font-medium text-[hsl(213_31%_91%)]">Enable Telegram Bot</p>
                                <p class="text-xs text-[hsl(215.4_16.3%_40%)]">Receive and respond to messages via Telegram</p>
                            </div>
                            <Switch Checked="@telegramEnabled" CheckedChanged="v => telegramEnabled = v" />
                        </div>

                        @if (telegramEnabled)
                        {
                            <div class="space-y-4 animate-fade-in">
                                <div class="space-y-2">
                                    <label class="text-sm font-medium text-[hsl(213_31%_91%)]">Bot Token</label>
                                    <Input Value="@botToken" OnInput="e => botToken = e.Value?.ToString() ?? string.Empty"
                                           Placeholder="123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ" />
                                    <p class="text-xs text-[hsl(215.4_16.3%_40%)]">Get from <span class="text-[hsl(220_100%_63%)]">&#64;BotFather</span> on Telegram</p>
                                </div>

                                <div class="space-y-2">
                                    <label class="text-sm font-medium text-[hsl(213_31%_91%)]">Allowed Chat IDs</label>
                                    <Input Value="@allowedChatIds" OnInput="e => allowedChatIds = e.Value?.ToString() ?? string.Empty"
                                           Placeholder="7683625462, -100123456789" />
                                    <p class="text-xs text-[hsl(215.4_16.3%_40%)]">Comma-separated. Find your ID via <span class="text-[hsl(220_100%_63%)]">&#64;userinfobot</span></p>
                                </div>

                                <div class="p-3 rounded-md bg-[hsl(220_100%_54%/0.08)] border border-[hsl(220_100%_54%/0.2)]">
                                    <p class="text-xs text-[hsl(220_100%_74%)]">
                                        🔒 Only whitelisted chat IDs can send commands. An empty list blocks all messages.
                                    </p>
                                </div>
                            </div>
                        }

                        <div class="flex justify-between pt-2">
                            <Button Variant="ghost" OnClick="PrevStep">Back</Button>
                            <Button Variant="default" OnClick="NextStep">@(telegramEnabled ? "Save & Continue" : "Skip")</Button>
                        </div>
                    </div>
                </ChildContent>
            </Card>
        }

        @if (AppState.CurrentOnboardingStep == OnboardingStep.Done)
        {
            <Card>
                <ChildContent>
                    <div class="text-center space-y-5 py-4">
                        <div class="flex items-center justify-center w-16 h-16 mx-auto rounded-full bg-emerald-900/30 border border-emerald-700/50">
                            <svg class="w-8 h-8 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="20 6 9 17 4 12"/>
                            </svg>
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-[hsl(213_31%_91%)]">You're all set!</h2>
                            <p class="text-sm text-[hsl(215.4_16.3%_56.9%)] mt-1">DotnetClaw is ready to assist you.</p>
                        </div>
                        <div class="grid grid-cols-2 gap-3 text-left">
                            <SummaryItem Label="Provider" Value="@selectedProvider.ToUpperInvariant()" />
                            <SummaryItem Label="Model" Value="@(string.IsNullOrWhiteSpace(modelId) ? Options.Value.ModelId : modelId)" />
                            <SummaryItem Label="Telegram" Value="@(telegramEnabled ? "Enabled" : "Disabled")" />
                            <SummaryItem Label="Status" Value="Ready" IsSuccess="true" />
                        </div>
                        <div class="flex gap-3 justify-center pt-2">
                            <Button Variant="outline" OnClick="() => AppState.CurrentOnboardingStep = OnboardingStep.Welcome">
                                Review Setup
                            </Button>
                            <Button Variant="default" OnClick="FinishOnboarding">
                                Go to Dashboard
                                <svg class="ml-2 w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M5 12h14M12 5l7 7-7 7"/>
                                </svg>
                            </Button>
                        </div>
                    </div>
                </ChildContent>
            </Card>
        }
    </div>
</div>

@code {
    private static readonly (OnboardingStep step, string label)[] Steps =
    [
        (OnboardingStep.Welcome, "Welcome"),
        (OnboardingStep.ModelSetup, "Model"),
        (OnboardingStep.TelegramSetup, "Telegram"),
        (OnboardingStep.Done, "Done"),
    ];

    private string selectedProvider = "openai";
    private string modelId = string.Empty;
    private string apiKey = string.Empty;
    private bool telegramEnabled = false;
    private string botToken = string.Empty;
    private string allowedChatIds = string.Empty;

    protected override void OnInitialized()
    {
        modelId = Options.Value.ModelId;
        telegramEnabled = Options.Value.Telegram.Enabled;
        botToken = Options.Value.Telegram.BotToken;
        allowedChatIds = string.Join(", ", Options.Value.Telegram.AllowedChatIds);
    }

    private void NextStep()
    {
        if (AppState.CurrentOnboardingStep < OnboardingStep.Done)
            AppState.CurrentOnboardingStep++;
    }

    private void PrevStep()
    {
        if (AppState.CurrentOnboardingStep > OnboardingStep.Welcome)
            AppState.CurrentOnboardingStep--;
    }

    private void FinishOnboarding()
    {
        AppState.OnboardingComplete = true;
        Nav.NavigateTo("/");
    }
}

